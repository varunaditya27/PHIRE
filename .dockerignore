# Backend's Docker build context is the repo root (see
# docker/Dockerfile.backend's header comment for why) -- without this,
# that build would ship .git, every package's venv, node_modules, and
# local runtime data into the build context on every build.

.git
**/.venv
**/venv
**/node_modules
**/__pycache__
**/*.pyc
data/
backend/data/
ml/data/
frontend/.next
frontend/out
*.log
.env
**/.env
!**/.env.example

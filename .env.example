# PHIRE root environment variables — copy to .env and fill in.
# Consumed by the root docker-compose.yml to configure shared services.
# Backend- and frontend-specific settings live in their own .env.example
# files (backend/.env.example, frontend/.env.example) — copy those too.
# Never commit the real .env file.

# --- PostgreSQL ---
# POSTGRES_USER=phire
# POSTGRES_PASSWORD=
# POSTGRES_DB=phire
# POSTGRES_PORT=5432

# --- Ollama ---
# OLLAMA_MODEL=medgemma:8b-q4_0        # or qwen2:7b-instruct-q4_0 / meditron:7b-q4_0
# OLLAMA_PORT=11434

# --- Service ports ---
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

# PHIRE root environment variables — copy to .env and fill in.
# Consumed by the root docker-compose.yml to configure shared services.
# Backend- and frontend-specific settings live in their own .env.example
# files (backend/.env.example, frontend/.env.example) — copy those too.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=phire
POSTGRES_PASSWORD=phire
POSTGRES_DB=phire
POSTGRES_PORT=5432

# --- Ollama ---
# medgemma:4b is the only tag ml/ pulls (ml/llm/ollama_client.py) --
# medgemma ships 4B/27B, not 8B.
OLLAMA_MODEL=medgemma:4b
OLLAMA_PORT=11434

# --- Neo4j (ml/graph -- Longitudinal Health Graph) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=phire-dev-password
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# --- Service ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# PHIRE root environment variables — copy to .env and fill in.
# Consumed by docker/docker-compose.yml to configure shared services.
# Backend- and frontend-specific settings live in their own .env.example
# files (backend/.env.example, frontend/.env.example) — copy those too.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=phire
POSTGRES_PASSWORD=phire
POSTGRES_DB=phire
POSTGRES_PORT=5432

# --- Ollama ---
# medgemma:4b is the only model the app uses (ml/llm/ollama_client.py) -- medgemma ships 4B/27B, not 8B.
# Docker uses the Ollama already running on the HOST (OLLAMA_HOST below). Only if you have none does
# scripts/run.sh start the bundled container (`--profile ollama`), which listens on OLLAMA_PORT.
OLLAMA_MODEL=medgemma:4b
OLLAMA_PORT=11434
# OLLAMA_HOST=http://localhost:11434

# --- Neo4j (ml/graph -- Longitudinal Health Graph) ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=phire-dev-password
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# --- Service ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Port of the optional nginx proxy profile (`--profile proxy`).
PROXY_PORT=8080

# --- Visual Document Extraction (Lift VLM) ---
# HuggingFace model identifier for Lift VLM (9.7B parameters)
LIFT_MODEL=datalab-to/lift
# Device placement: "auto" (select CUDA if available, else CPU), "cuda", or "cpu"
LIFT_DEVICE=auto
# Set to "true" to use deterministic mock fixtures in tests without downloading/running the VLM
PHIRE_MOCK_LIFT=false

# --- GPU or CPU variant ---
# scripts/run.sh and scripts/setup.sh pick `gpu` when an NVIDIA GPU/runtime is found, else `cpu`. Force with:
# PHIRE_VARIANT=cpu
# Document extraction: auto = lift on a CUDA GPU, otherwise the Ollama vision model; or force `lift` / `ollama`.
# PHIRE_EXTRACTOR=auto
# Vision model used by the Ollama extractor (default: OLLAMA_MODEL, i.e. medgemma:4b -- already pulled for chat).
# OLLAMA_VISION_MODEL=

# --- Docker deployment (docker/docker-compose.yml) ---
# Always pass this file explicitly: docker compose --env-file .env -f docker/docker-compose.yml ...
# (scripts/run.sh does). Compose would otherwise read docker/.env and ignore this one.

# Host user the backend container runs as, so files in PHIRE_DATA_DIR are owned by you (`id -u` / `id -g`).
PHIRE_UID=1000
PHIRE_GID=1000

# Where uploads, Chroma (incl. the reference corpus), the audit log and the ingest manifest live.
# Relative paths resolve against docker/. Default: the repo's data/ (shared with a local run).
# PHIRE_DATA_DIR=../data

# Hugging Face weights cache (lift 18GB, MedCPT, BART). Named volume by default; point it at an
# existing host cache to avoid re-downloading, e.g. HF_CACHE_DIR=/home/you/.cache/huggingface
# HF_CACHE_DIR=

# Only for the optional bundled Ollama container: reuse a models directory (a path, or unset = named volume).
# OLLAMA_MODELS_DIR=

# Interface the backend binds to. Loopback keeps PHIRE (no authentication) off the LAN; use 0.0.0.0
# only together with the nginx `proxy` profile on a network you trust.
# BACKEND_HOST=127.0.0.1

# API URL baked into the frontend bundle at BUILD time. Unset = http://localhost:$BACKEND_PORT.
# Set to empty for same-origin calls through the nginx proxy profile. Rebuild after changing it.
# NEXT_PUBLIC_API_URL=


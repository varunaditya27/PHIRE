# Backend environment variables — copy to backend/.env and fill in.
# Names match app/config.py's Settings fields (case-insensitive). Never
# commit the real .env file.

DATABASE_URL=postgresql+psycopg2://phire:phire@localhost:5432/phire

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=medgemma:4b
OLLAMA_TIMEOUT_SECONDS=30

# ml/rag/ingest's OCR + prose-extraction models (see ml/.env.example) --
# not read directly by backend code, kept here so one .env configures
# everything ml/ needs when backend calls into it.
OCR_MODEL=olmocr
PROSE_EXTRACTION_MODEL=qwen3.5:9b

# ml/graph -- Longitudinal Health Graph (see ml/.env.example for the
# local dev container command). Required for /api/chat, /api/patient/*,
# and document ingestion's graph-writing step.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Left unset here on purpose: app/config.py's default already resolves to
# <repo_root>/data/chroma, matching ml/rag/retriever.py's own
# repo-root-relative DEFAULT_CHROMA_DIR regardless of which directory
# either process is launched from. Setting this to a relative path like
# "./data/chroma" would resolve against the *process's* cwd instead
# (backend/ for a local run -- see scripts/run_backend.sh) and silently
# diverge from ml/'s standalone scripts (e.g. run_ingest.py, run from the
# repo root), which is the exact bug this default was written to avoid.
# Only set CHROMA_PERSIST_DIR here with an absolute path.
# CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=phire_evidence

CORS_ORIGINS=["http://localhost:3000"]

UPLOAD_DIR=./data/documents
UPLOAD_MAX_SIZE_BYTES=26214400

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
AUDIT_LOG_PATH=./data/audit.log

ENVIRONMENT=development

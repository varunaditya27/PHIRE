# Backend environment variables — copy to backend/.env and fill in.
# Never commit the real .env file.

# DATABASE_URL=postgresql://user:pass@localhost:5432/phire
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=medgemma:8b-q4_0        # or qwen2:7b-instruct-q4_0 / meditron:7b-q4_0
# CHROMA_PERSIST_DIR=./data/chroma     # local persistence dir for the in-process Chroma client
# CORS_ORIGINS=http://localhost:3000
# ENCRYPTION_KEY=

# Backend service image (FastAPI), standalone single-service build --
# ml/-free (no ml/requirements.txt, no ml/ source), for running backend/
# on its own outside the full compose stack. Build context is backend/,
# not the repo root:
#   docker build -f docker/Dockerfile.backend.standalone -t phire-backend-standalone backend/
# See docker/Dockerfile.backend for the compose-driven equivalent used by
# docker/docker-compose.yml (repo-root context, includes ml/'s deps) --
# keep the two in sync where they overlap.

FROM python:3.11-slim

# libpq-dev + build-essential for psycopg2.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ ./app
COPY alembic.ini .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

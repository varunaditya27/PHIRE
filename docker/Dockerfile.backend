# Compose-driven build for the FastAPI backend service.
# Referenced by docker/docker-compose.yml's `backend` service (build
# context: repo root "..", dockerfile: docker/Dockerfile.backend -- the
# sole compose file; see its own header comment). See
# docker/Dockerfile.backend.standalone for the standalone single-service
# equivalent (ml/-free, kept separately) — keep the two in sync where
# they overlap. Build-time file exclusions live alongside this file at
# docker/Dockerfile.backend.dockerignore, not a repo-root .dockerignore.
#
# Build context is the repo root, not backend/ -- this image installs
# ml/'s Python dependencies (torch, transformers, neo4j driver, etc, per
# ml/requirements.txt) alongside backend's own, so router_chat.py /
# router_claims.py / router_evidence.py / router_search.py's real
# `import ml....` calls (see app/services/ml_singletons.py) actually
# resolve inside the container instead of ImportError-ing. ml/'s *source*
# still isn't baked into the image, though -- docker-compose mounts ../ml
# read-only at /app/ml at runtime (see docker/docker-compose.yml), so
# editing ml/ locally doesn't require an image rebuild, only its
# dependency list changing does.

FROM python:3.12-slim

# libpq-dev + build-essential for psycopg2 and any ml/ deps needing a
# native build. Visual document extraction (datalab-to/lift) runs in-process
# via PyTorch and does not need the system tesseract-ocr binary.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip to the latest version to support Python 3.12 and newer packages
RUN pip install --upgrade pip

WORKDIR /app

COPY backend/requirements.txt ./backend-requirements.txt
COPY ml/requirements.txt ./ml-requirements.txt
RUN pip install --no-cache-dir -r backend-requirements.txt -r ml-requirements.txt

COPY backend/app/ ./app
COPY backend/alembic.ini .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]

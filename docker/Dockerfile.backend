# Backend (FastAPI) image, used by docker/docker-compose.yml's `backend` and `ingest` services
# (build context: repo root "..", dockerfile: docker/Dockerfile.backend). This is the only
# backend image: the backend cannot run without ml/ (every ML route imports it), so the old
# ml/-free "standalone" Dockerfile was removed -- it crashed on `import ml` at startup.
# Build-time exclusions live in docker/Dockerfile.backend.dockerignore (BuildKit looks for
# <dockerfile>.dockerignore next to the Dockerfile).
#
# The build context is the repo root because this image installs ml/'s Python dependencies
# (torch, transformers, lift, neo4j driver, ...) alongside backend's own, and bakes in ml/'s
# source. (It used to bind-mount ../ml at runtime; on SELinux hosts such as Fedora the container
# could not read that mount at all, and a deployment should not depend on a live checkout.) ml/
# is copied after the dependency layer, so editing it only rebuilds the last, tiny layers.
#
# Runs as a non-root user (compose overrides the uid/gid to match the host user so files in the
# bind-mounted data dir are yours). Model weights are cached under /hf (a volume), not in the image.

# 3.12, not 3.11: lift-pdf requires Python >= 3.12 (pip finds no matching version on 3.11).
FROM python:3.12-slim

# VARIANT=gpu (default): PyTorch's CUDA wheels + lift (needs an NVIDIA GPU at run time).
# VARIANT=cpu: CPU-only PyTorch (~0.2GB instead of several GB) and no lift; documents are read by an
# Ollama vision model instead (PHIRE_EXTRACTOR=ollama). Select with docker/docker-compose.cpu.yml.
ARG VARIANT=gpu

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/hf \
    TORCH_HOME=/hf/torch \
    XDG_CACHE_HOME=/hf/xdg

# libpq-dev + build-essential for psycopg2 and any ml/ dependency needing a native build.
# Visual extraction (datalab-to/lift) runs in-process via PyTorch; no tesseract binary needed.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 1000 phire && useradd -u 1000 -g 1000 -m phire \
    && mkdir -p /hf && chown phire:phire /hf

WORKDIR /app

COPY backend/requirements.txt ./backend-requirements.txt
COPY ml/requirements.txt ./ml-requirements.txt
COPY ml/requirements-lift.txt ./ml-requirements-lift.txt
# CPU torch is installed first so the unpinned `torch` in ml-requirements.txt is already satisfied and pip
# does not replace it with the (much larger) CUDA build.
RUN if [ "$VARIANT" = "cpu" ]; then pip install torch --index-url https://download.pytorch.org/whl/cpu; fi \
 && pip install -r backend-requirements.txt -r ml-requirements.txt \
 && if [ "$VARIANT" != "cpu" ]; then pip install -r ml-requirements-lift.txt; fi

COPY backend/app/ ./app
COPY ml/ ./ml
COPY backend/alembic.ini .
COPY docker/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh

USER phire
EXPOSE 8000

ENTRYPOINT ["backend-entrypoint.sh"]
